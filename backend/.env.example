# --- Core ---
DATABASE_URL=sqlite+aiosqlite:///./relay.db
JWT_SECRET=change-this-to-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# --- AI ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxx
AI_MODEL=claude-sonnet-4-6
AI_MAX_CONCURRENCY=10          # parallel in-flight AI calls during bulk jobs
AI_MAX_RETRIES=3

# --- Email providers (OAuth — never store raw passwords) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
FRONTEND_URL=http://localhost:5173

# Fernet key used to encrypt stored OAuth tokens at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TOKEN_ENCRYPTION_KEY=

MS_CLIENT_ID=
MS_CLIENT_SECRET=
MS_REDIRECT_URI=http://localhost:8000/auth/microsoft/callback

# --- CORS ---
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
